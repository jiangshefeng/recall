# demo: no network/model required; live: real LLM + embedding APIs
RAG_MODE=demo

# OpenAI-compatible base URLs, including /v1 when required by your provider.
# Chat and embedding may use different providers. Never use NEXT_PUBLIC_ for keys.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=qwen3.8-max
# chat_completions (default), or responses for Responses-only gateways.
LLM_API_STYLE=chat_completions
# Responses mode only; use a value supported by the selected model.
LLM_REASONING_EFFORT=low
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# Multiple summaries use array input; failed batches fall back to up to 3 concurrent single requests.

# Optional SQLite path; defaults to data/rag.sqlite under the project directory.
# RAG_DB_PATH=/absolute/path/to/rag.sqlite

# Real-mode thresholds must be calibrated for your embedding model.
RAG_SEARCH_THRESHOLD=0.45
RAG_MERGE_THRESHOLD=0.6
RAG_STAGE_SOURCE_THRESHOLD=5
RAG_STAGE_CHAR_THRESHOLD=12000
RAG_MERGE_INPUT_MAX_CHARS=64000
RAG_MERGE_INPUT_MAX_TOKENS=20000

# Retrieval limits; token count is an estimate, not the provider's exact tokenizer.
RAG_FIRST_CANDIDATES=100
RAG_FIRST_LIMIT=5
RAG_NEIGHBORS_PER_SEED=100
RAG_SECOND_LIMIT=10
RAG_SOURCE_CANDIDATES_PER_MEMORY=4
RAG_SOURCE_LIMIT_PER_MEMORY=2
RAG_MAX_RECORDS=15
RAG_CONTEXT_MAX_CHARS=18000
RAG_CONTEXT_MAX_TOKENS=6000
RAG_RECORD_MAX_CHARS=5000
